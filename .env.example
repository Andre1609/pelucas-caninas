# Copia este archivo a .env.local y completa tus datos.
# Con Neon usa la cadena de conexión terminada en ?sslmode=verify-full
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pelucas"
NEXT_PUBLIC_WHATSAPP="51900000000"
NEXT_PUBLIC_EMAIL="correo@ejemplo.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Panel de administración: genera estas 3 con "npm run admin:clave"
ADMIN_USER=""
ADMIN_PASSWORD_HASH=""
AUTH_SECRET=""

# Pon "off" para probar reservas sin el límite de 2 por día en tu computadora
LIMITE_RESERVAS=""
